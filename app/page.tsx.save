                {t.performanceTitle1}
                <br />

                <span className="text-white/30">
                  {t.performanceTitle2}
                </span>
              </h2>

              <p className="mt-6 leading-8 text-white/40">
                {t.performanceDescription}
              </p>

              <div className="mt-8 space-y-4">
                {[
                  t.performance1,
                  t.performance2,
                  t.performance3,
                  t.performance4,
                ].map((item) => (
                  <div
                    key={item}
                    className="flex items-center gap-3 text-sm text-white/60"
                  >
                    <div className="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#8cff00]/10 text-[#8cff00]">
                      <Check size={14} />
                    </div>

                    {item}
                  </div>
                ))}
              </div>
            </div>

            <motion.div
              initial={{
                opacity: 0,
                x: isArabic ? -40 : 40,
              }}
              whileInView={{
                opacity: 1,
                x: 0,
              }}
              viewport={{
                once: true,
              }}
              className="overflow-hidden rounded-[40px] border border-white/[0.08] bg-[#090b0d]"
            >
              <img
                src="/product/performance.png"
                alt="FLEX performance"
                className="w-full object-cover"
              />
            </motion.div>
          </div>
        </div>
      </section>

      {/* ================= DETAILS ================= */}

      <section className="py-28">
        <div className="mx-auto max-w-7xl px-5 lg:px-8">
          <div className="mx-auto max-w-2xl text-center">
            <div className="text-sm font-black tracking-widest text-[#8cff00]">
              {t.detailsLabel}
            </div>

            <h2 className="mt-4 text-4xl font-black sm:text-5xl">
              {t.detailsTitle}
            </h2>

            <p className="mt-5 leading-8 text-white/40">
              {t.detailsDescription}
            </p>
          </div>

          <motion.div
            initial={{
              opacity: 0,
              y: 30,
            }}
            whileInView={{
              opacity: 1,
              y: 0,
            }}
            viewport={{
              once: true,
            }}
            className="mt-14 overflow-hidden rounded-[40px] border border-white/[0.08] bg-[#090b0d]"
          >
            <img
              src="/product/detail-closeup.png"
              alt="FLEX product details"
              className="w-full"
            />
          </motion.div>
        </div>
      </section>

      {/* ================= ACTIVITIES ================= */}

      <section
        id="activities"
        className="border-y border-white/[0.05] bg-white/[0.015] py-28"
      >
        <div className="mx-auto max-w-7xl px-5 lg:px-8">
          <div className="grid items-center gap-12 lg:grid-cols-2">
            <motion.div
              initial={{
                opacity: 0,
                x: isArabic ? 40 : -40,
              }}
              whileInView={{
                opacity: 1,
                x: 0,
              }}
              viewport={{
                once: true,
              }}
              className="overflow-hidden rounded-[40px] border border-white/[0.08]"
            >
              <img
                src="/product/activities.png"
                alt="FLEX activities"
                className="w-full"
              />
            </motion.div>

            <div>
              <div className="text-sm font-black tracking-widest text-[#8cff00]">
                {t.activitiesLabel}
              </div>

              <h2 className="mt-4 text-4xl font-black sm:text-5xl">
                {t.activitiesTitle1}
                <br />

                <span className="text-white/30">
                  {t.activitiesTitle2}
                </span>
              </h2>

              <p className="mt-6 leading-8 text-white/40">
                {t.activitiesDescription}
              </p>

              <div className="mt-8 grid grid-cols-2 gap-3">
                {[
                  t.training,
                  t.running,
                  t.cycling,
                  t.everyday,
                ].map((item) => (
                  <div
                    key={item}
                    className="rounded-2xl border border-white/[0.07] bg-white/[0.025] px-5 py-4 text-sm font-bold text-white/60"
                  >
                    <span className="mr-2 text-[#8cff00]">
                      +
                    </span>

                    {item}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* ================= SIZE ================= */}

      <section className="py-28">
        <div className="mx-auto max-w-7xl px-5 lg:px-8">
          <div className="grid items-center gap-14 lg:grid-cols-2">
            <div>
              <div className="flex items-center gap-2 text-sm font-black tracking-widest text-[#8cff00]">
                <Ruler size={16} />
                {t.sizeLabel}
              </div>

              <h2 className="mt-4 text-4xl font-black sm:text-5xl">
                {t.sizeTitle1}
                <br />

                <span className="text-white/30">
                  {t.sizeTitle2}
                </span>
              </h2>

              <p className="mt-6 leading-8 text-white/40">
                {t.sizeDescription}
              </p>

              <div className="mt-8 grid grid-cols-4 gap-2">
                {["M", "L", "XL", "XXL"].map(
                  (item) => (
                    <button
                      key={item}
                      type="button"
                      onClick={() => setSize(item)}
                      className={`rounded-xl border py-4 font-black transition ${
                        size === item
                          ? "border-[#8cff00] bg-[#8cff00] text-black"
                          : "border-white/10 bg-white/[0.03] text-white/70 hover:border-[#8cff00]/50 hover:text-[#8cff00]"
                      }`}
                    >
                      {item}
                    </button>
                  )
                )}
              </div>
            </div>

            <motion.div
              initial={{
                opacity: 0,
                x: isArabic ? -40 : 40,
              }}
              whileInView={{
                opacity: 1,
                x: 0,
              }}
              viewport={{
                once: true,
              }}
              className="overflow-hidden rounded-[40px] border border-white/[0.08] bg-[#090b0d]"
            >
              <img
                src="/product/sizes.png"
                alt="FLEX size guide"
                className="w-full"
              />
            </motion.div>
          </div>
        </div>
      </section>

      {/* ================= ORDER ================= */}

      <section
        id="order"
        className="scroll-mt-24 border-t border-white/[0.05] px-5 py-28"
      >
        <div className="mx-auto max-w-6xl">
          <div className="mb-12 text-center">
            <div className="text-sm font-black tracking-[0.25em] text-[#8cff00]">
              {t.orderLabel}
            </div>

            <h2 className="mt-4 text-4xl font-black sm:text-6xl">
              {t.orderTitle}
            </h2>

            <p className="mx-auto mt-5 max-w-xl leading-8 text-white/40">
              {t.orderDescription}
            </p>
          </div>

          {submitted ? (
            <motion.div
              initial={{
                opacity: 0,
                scale: 0.95,
              }}
              animate={{
                opacity: 1,
                scale: 1,
              }}
              className="mx-auto max-w-3xl rounded-[40px] border border-[#8cff00]/20 bg-[#0b1008] p-10 text-center sm:p-16"
            >
              <div className="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#8cff00]/10 text-[#8cff00]">
                <Check size={38} />
              </div>

              <h3 className="mt-7 text-3xl font-black sm:text-4xl">
                {t.successTitle}
              </h3>

              <p className="mx-auto mt-5 max-w-xl leading-8 text-white/40">
                {t.successDescription}
              </p>

              <button
                type="button"
                onClick={resetOrder}
                className="mt-8 rounded-2xl bg-[#8cff00] px-8 py-4 font-black text-black transition hover:scale-105"
              >
                {t.orderAgain}
              </button>
            </motion.div>
          ) : (
            <form
              onSubmit={handleSubmit}
              className="grid gap-6 lg:grid-cols-[1.25fr_.75fr]"
            >
              {/* FORM */}

              <div className="rounded-[35px] border border-white/[0.08] bg-white/[0.025] p-6 sm:p-8">
                <div className="grid gap-5 sm:grid-cols-2">
                  <label className="block">
                    <span className="mb-2 block text-xs font-bold text-white/50">
                      {t.fullName} *
                    </span>

                    <input
                      required
                      name="name"
                      type="text"
                      placeholder={t.fullName}
                      className="h-14 w-full rounded-xl border border-white/10 bg-black/30 px-4 text-sm text-white outline-none transition placeholder:text-white/20 focus:border-[#8cff00]/60"
                    />
                  </label>

                  <label className="block">
                    <span className="mb-2 block text-xs font-bold text-white/50">
                      {t.phone} *
                    </span>

                    <input
                      required
                      name="phone"
                      type="tel"
                      placeholder={t.phone}
                      className="h-14 w-full rounded-xl border border-white/10 bg-black/30 px-4 text-sm text-white outline-none transition placeholder:text-white/20 focus:border-[#8cff00]/60"
                    />
                  </label>

                  <label className="block">
                    <span className="mb-2 block text-xs font-bold text-white/50">
                      {t.governorate} *
                    </span>

                    <input
                      required
                      name="governorate"
                      type="text"
                      placeholder={t.governorate}
                      className="h-14 w-full rounded-xl border border-white/10 bg-black/30 px-4 text-sm text-white outline-none transition placeholder:text-white/20 focus:border-[#8cff00]/60"
                    />
                  </label>

                  <label className="block">
                    <span className="mb-2 block text-xs font-bold text-white/50">
                      {t.size} *
                    </span>

                    <select
                      required
                      name="size"
                      value={size}
                      onChange={(event) =>
                        setSize(event.target.value)
                      }
                      className="h-14 w-full rounded-xl border border-white/10 bg-[#0b0c0d] px-4 text-sm text-white outline-none focus:border-[#8cff00]/60"
                    >
                      <option value="M">M</option>
                      <option value="L">L</option>
                      <option value="XL">XL</option>
                      <option value="XXL">XXL</option>
                    </select>
                  </label>
                </div>

                <label className="mt-5 block">
                  <span className="mb-2 block text-xs font-bold text-white/50">
                    {t.address} *
                  </span>

                  <textarea
                    required
                    name="address"
                    rows={4}
                    placeholder={t.address}
                    className="w-full resize-none rounded-xl border border-white/10 bg-black/30 p-4 text-sm text-white outline-none transition placeholder:text-white/20 focus:border-[#8cff00]/60"
                  />
                </label>

                <label className="mt-5 block">
                  <span className="mb-2 block text-xs font-bold text-white/50">
                    {t.notes}{" "}
                    <span className="text-white/20">
                      ({t.notesOptional})
                    </span>
                  </span>

                  <textarea
                    name="notes"
                    rows={3}
                    placeholder={t.notes}
                    className="w-full resize-none rounded-xl border border-white/10 bg-black/30 p-4 text-sm text-white outline-none transition placeholder:text-white/20 focus:border-[#8cff00]/60"
                  />
                </label>

                {/* QUANTITY */}

                <div className="mt-6">
                  <span className="mb-3 block text-xs font-bold text-white/50">
                    {t.quantity}
                  </span>

                  <div className="flex w-fit items-center overflow-hidden rounded-xl border border-white/10 bg-black/30">
                    <button
                      type="button"
                      onClick={() =>
                        setQuantity((current) =>
                          Math.max(
                            1,
                            current - 1
                          )
                        )
                      }
                      className="flex h-12 w-12 items-center justify-center text-white/50 transition hover:bg-white/5 hover:text-white"
                    >
                      <Minus size={16} />
                    </button>

                    <div className="flex h-12 min-w-14 items-center justify-center border-x border-white/10 text-sm font-black">
                      {quantity}
                    </div>

                    <button
                      type="button"
                      onClick={() =>
                        setQuantity((current) =>
                          Math.min(
                            10,
                            current + 1
                          )
                        )
                      }
                      className="flex h-12 w-12 items-center justify-center text-white/50 transition hover:bg-white/5 hover:text-white"
                    >
                      <Plus size={16} />
                    </button>
                  </div>
                </div>

                {/* PAYMENT */}

                <div className="mt-7">
                  <span className="mb-3 block text-xs font-bold text-white/50">
                    {t.payment}
                  </span>

                  <div className="rounded-2xl border border-[#8cff00]/30 bg-[#8cff00]/5 p-4">
                    <div className="flex items-start gap-3">
                      <div className="mt-0.5 flex h-5 w-5 items-center justify-center rounded-full border border-[#8cff00]">
                        <div className="h-2.5 w-2.5 rounded-full bg-[#8cff00]" />
                      </div>

                      <div>
                        <div className="font-bold text-white">
                          {t.cashDelivery}
                        </div>

                        <div className="mt-1 text-xs text-white/35">
                          {t.paymentDescription}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              {/* ORDER SUMMARY */}

              <div className="h-fit rounded-[35px] border border-white/[0.08] bg-[#090b0d] p-6 sm:p-8 lg:sticky lg:top-28">
                <div className="flex items-center gap-2 text-sm font-black tracking-widest text-[#8cff00]">
                  <ShoppingBag size={17} />
                  {t.summary}
                </div>

                <div className="mt-7 flex gap-4">
                  <div className="h-24 w-24 shrink-0 overflow-hidden rounded-2xl border border-white/10 bg-black/30">
                    <img
                      src="/product/hero-premium.png"
                      alt="FLEX Knee Support"
                      className="h-full w-full object-contain"
                    />
                  </div>

                  <div>
                    <h3 className="font-black">
                      {t.product}
                    </h3>

                    <p className="mt-1 text-xs text-white/30">
                      {t.size}: {size}
                    </p>

                    <p className="mt-1 text-xs text-white/30">
                      {t.quantity}: {quantity}
                    </p>
                  </div>
                </div>

                <div className="my-7 h-px bg-white/[0.07]" />

                <div className="space-y-4 text-sm">
                  <div className="flex justify-between text-white/40">
                    <span>{t.subtotal}</span>

                    <span>
                      {formatPrice(
                        PRODUCT_PRICE * quantity
                      )}{" "}
                      {t.egp}
                    </span>
                  </div>

                  <div className="flex justify-between text-white/40">
                    <span>{t.delivery}</span>

                    <span className="font-bold text-[#8cff00]">
                      {t.free}
                    </span>
                  </div>

                  <div className="h-px bg-white/[0.07]" />

                  <div className="flex items-end justify-between">
                    <span className="font-bold text-white/50">
                      {t.total}
                    </span>

                    <span className="text-3xl font-black">
                      {formatPrice(total)}{" "}
                      <span className="text-sm text-white/40">
                        {t.egp}
                      </span>
                    </span>
                  </div>
                </div>

                <button
                  type="submit"
                  disabled={processing}
                  className="mt-7 flex w-full items-center justify-center gap-3 rounded-2xl bg-[#8cff00] px-6 py-5 font-black text-black transition hover:scale-[1.02] disabled:cursor-not-allowed disabled:opacity-60"
                >
                  {processing
                    ? t.processing
                    : t.placeOrder}

                  {!processing && (
                    <ArrowRight size={18} />
                  )}
                </button>

                <div className="mt-5 flex items-center justify-center gap-2 text-center text-[11px] text-white/25">
                  <ShieldCheck size={14} />
                  {t.cashDelivery}
                </div>
              </div>
            </form>
          )}
        </div>
      </section>

      {/* ================= FINAL CTA ================= */}

      <section className="px-5 py-28">
        <div className="relative mx-auto max-w-5xl overflow-hidden rounded-[45px] border border-[#8cff00]/20 bg-gradient-to-br from-[#11180c] to-[#070909] p-10 text-center sm:p-16">
          <div className="pointer-events-none absolute left-1/2 top-1/2 h-96 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#8cff00]/10 blur-[120px]" />

          <div className="relative">
            <div className="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-[#8cff00]/10 text-[#8cff00]">
              <Zap size={28} />
            </div>

            <div className="mt-7 text-sm font-black tracking-[0.25em] text-[#8cff00]">
              {t.readyLabel}
            </div>

            <h2 className="mt-4 text-4xl font-black sm:text-6xl">
              {t.readyTitle}
            </h2>

            <p className="mx-auto mt-5 max-w-xl leading-8 text-white/40">
              {t.readyDescription}
            </p>

            <button
              type="button"
              onClick={scrollToOrder}
              className="mt-9 inline-flex items-center gap-3 rounded-2xl bg-[#8cff00] px-10 py-5 font-black text-black transition hover:scale-105"
            >
              <ShoppingBag size={19} />
              {t.buyNow}
            </button>
          </div>
        </div>
      </section>

      {/* ================= FOOTER ================= */}

      <footer className="border-t border-white/[0.06] py-9">
        <div className="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-5 text-xs text-white/25 sm:flex-row lg:px-8">
          <div>
            © 2026 FLEX PERFORMANCE
          </div>

          <div className="flex gap-6">
            <span>{t.privacy}</span>
            <span>{t.terms}</span>
            <span>{t.contact}</span>
          </div>
        </div>
      </footer>
    </main>
  );
}
